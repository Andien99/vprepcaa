{
  "name": "vprepcaa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "vprepcaa: VCAA exam practice platform (successor to vcaa-pixel-practice).",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p web/jsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply vprepcaa-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vprepcaa-db --remote",
    "db:seed:local": "wrangler d1 execute vprepcaa-db --local --file=seeds/dev.sql",
    "test:db": "node --no-warnings tests/db/schema.test.mjs",
    "test:auth": "node --no-warnings tests/auth/auth-writes.test.mjs",
    "test": "npm run test:db && npm run test:auth",
    "db:migrate:preview": "wrangler d1 migrations apply vprepcaa-db-preview --remote --config wrangler.preview-migrations.jsonc"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
